# Public Supabase values. Safe to expose to the browser, but keep local in .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-project-publishable-key

# Server-only PostgreSQL URLs for Prisma 7.
# Use the pooled runtime URL for application queries and the direct session-mode
# URL for Prisma migrations. Do not commit real values.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres
