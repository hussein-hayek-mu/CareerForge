generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Owner/public access and source-grounded writes are enforced by SQL/RPCs.
model Portfolio {
  id                String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String @unique @map("user_id") @db.Uuid
  slug              String @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  template          String @default("studio")
  palette           String @default("chartreuse")
  colorMode         String @default("dark") @map("color_mode")
  sections          String[] @default(["about", "project", "skills"])
  revision          String @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  isPublic          Boolean @default(false) @map("is_public")
  publishedSnapshot Json? @map("published_snapshot")
  publishedAt       DateTime? @map("published_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(dbgenerated("clock_timestamp()")) @map("updated_at") @db.Timestamptz(6)
  @@map("portfolios")
}

// Server-graded checks: client writes denied; grading RPC and ownership FK in SQL.
model SkillCheckAttempt {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId  String @map("user_id") @db.Uuid
  skill   String
  version Int
  score   Int
  passed  Boolean
  takenAt DateTime @default(now()) @map("taken_at") @db.Timestamptz(6)
  session SkillCheckSession?
  @@index([userId, takenAt(sort: Desc)], map: "skill_check_owner_time_idx")
  @@map("skill_check_attempts")
}

// Session writes, timing constraints, owner RLS and the one-active-owner partial
// unique index are enforced by the reviewed SQL migration/RPCs.
model SkillCheckSession {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String @map("user_id") @db.Uuid
  skill       String
  version     Int
  timingMode  String @map("timing_mode")
  startedAt   DateTime @map("started_at") @db.Timestamptz(6)
  deadlineAt  DateTime @map("deadline_at") @db.Timestamptz(6)
  state       String @default("active")
  resultId    String? @unique @map("result_id") @db.Uuid
  result      SkillCheckAttempt? @relation(fields: [resultId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(6)

  @@index([userId, startedAt(sort: Desc)], map: "skill_check_session_owner_time_idx")
  @@map("skill_check_sessions")
}

// Supabase-managed auth tables are intentionally not represented here.
// The auth.users FK, trigger, RLS and grants live in supabase/migrations.
model Profile {
  id                 String   @id @db.Uuid
  role               String   @default("student")
  fullName           String   @default("") @map("full_name")
  headline           String   @default("")
  location           String   @default("")
  bio                String   @default("")
  educationSummary   String   @default("") @map("education_summary")
  projectSummary     String   @default("") @map("project_summary")
  selfReportedSkills String[] @default([]) @map("self_reported_skills")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("profiles")
}

model JobPosting {
  id             String     @id
  title          String
  company        String
  initials       String
  location       String
  workMode       String     @map("work_mode")
  employmentType String     @map("employment_type")
  skills         String[]
  description    String
  color          String
  isActive       Boolean    @default(true) @map("is_active")
  isFictional    Boolean    @default(true) @map("is_fictional")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  savedJobs      SavedJob[]

  @@map("job_postings")
}

// Ownership FK to auth.users and trigger-controlled revision/timestamps live in SQL.
model SavedJob {
  userId    String     @map("user_id") @db.Uuid
  jobId     String     @map("job_id")
  status    String     @default("Saved")
  revision  String     @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  job       JobPosting @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@id([userId, jobId])
  @@index([jobId], map: "saved_jobs_job_id_idx")
  @@map("saved_jobs")
}
