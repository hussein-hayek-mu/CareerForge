{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "CareerForge: Install Dependencies",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"ci",
				"--no-audit",
				"--no-fund",
				"--prefer-offline"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "CareerForge: Start Dev Server",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"dev"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "CareerForge: Validate",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/d",
				"/c",
				"npm.cmd run lint && npm.cmd run typecheck && npm.cmd test && npm.cmd run build"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}
