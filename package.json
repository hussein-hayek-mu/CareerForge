{
  "name": "careerforge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:offline": "node scripts/build-offline.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "test:hydration": "node scripts/verify-root-hydration.mjs",
    "test": "node scripts/test-unit.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "test:rls": "node scripts/test-rls.mjs",
    "test:account:live": "node scripts/test-account-live.mjs",
    "prisma:generate": "prisma generate",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "audit:performance": "node scripts/audit-performance.mjs",
    "test:e2e:ci": "playwright test --config playwright.ci.config.ts",
    "check:deployment": "node scripts/check-deployment.mjs",
    "build:deploy": "npm run check:deployment && npm run prisma:generate && next build",
    "test:skill-checks": "node scripts/test-skill-checks.mjs",
    "test:portfolios": "node scripts/test-portfolios.mjs",
    "test:portfolio-appearance": "node scripts/test-portfolio-appearance.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.75.0",
    "next": "^16.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.37.0",
    "eslint-config-next": "^16.4.2",
    "pg": "^8.16.3",
    "prisma": "^7.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "22.x"
  }
}
